{
  "name": "@apponexthrms/database",
  "version": "0.1.0",
  "description": "Database migrations and seeds",
  "private": true,
  "scripts": {
    "migrate": "knex migrate:latest --knexfile knexfile.ts",
    "migrate:create": "knex migrate:make --knexfile knexfile.ts",
    "migrate:rollback": "knex migrate:rollback --knexfile knexfile.ts",
    "seed": "knex seed:run --knexfile knexfile.ts",
    "seed:create": "knex seed:make --knexfile knexfile.ts"
  },
  "dependencies": {
    "knex": "^3.1.0",
    "mysql2": "^3.6.5"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
