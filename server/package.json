{
  "name": "@apponexthrms/server",
  "version": "0.1.0",
  "description": "Express backend API",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "predev": "npm run build --workspace=@apponexthrms/shared",
    "dev": "tsx watch ./src/server.ts",
    "build": "echo 'Build skipped - using tsx for runtime transpilation'",
    "start": "tsx ./src/server.ts",
    "db:cleanup-employee-types": "tsx ./src/scripts/cleanup-employee-types.ts",
    "biometric:sync": "tsx ./src/scripts/sync-biometric-profiles.ts",
    "biometric:test-identification": "tsx ./src/scripts/test-biometric-identification.ts",
    "type-check": "tsc --noEmit --skipLibCheck || true",
    "lint": "eslint src --ext .ts",
    "seed:superadmin": "tsx ./src/db/seeds/setup-superadmin-direct.ts",
    "seed:shifts": "tsx ./src/db/seeds/seed_shift_management.ts",
    "seed:locations": "tsx ./src/db/seeds/seed_location_management.ts",
    "seed:superadmin-tables": "tsx ./src/db/seeds/seed-superadmin-tables.ts",
    "db:seed": "node dbseed.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@apponexthrms/shared": "*",
    "@google/generative-ai": "^0.24.1",
    "argon2": "^0.31.2",
    "axios": "^1.6.2",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "ipaddr.js": "^2.1.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "mysql2": "^3.6.5",
    "nodemailer": "^6.9.7",
    "openid-client": "^5.4.2",
    "otplib": "^12.0.1",
    "pino": "^8.17.2",
    "pino-pretty": "^13.1.3",
    "qrcode": "^1.5.3",
    "socket.io": "^4.7.2",
    "uuid": "^9.0.1",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "@types/argon2": "^0.15.4",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.10.6",
    "@types/multer": "^1.4.11",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.6.0"
  }
}
